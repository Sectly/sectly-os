// SectlyOS Plymouth boot splash

background_color.red   = 0.05;
background_color.green = 0.05;
background_color.blue  = 0.05;

Window.SetBackgroundTopColor(background_color.red, background_color.green, background_color.blue);
Window.SetBackgroundBottomColor(background_color.red, background_color.green, background_color.blue);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();
img_width     = logo.image.GetWidth();
img_height    = logo.image.GetHeight();

// Scale logo to 20% of screen height, preserve aspect ratio
scale         = screen_height * 0.20 / img_height;
scaled_width  = Math.Int(img_width  * scale);
scaled_height = Math.Int(img_height * scale);

logo.image    = logo.image.Scale(scaled_width, scaled_height);
logo.sprite   = Sprite(logo.image);
logo.sprite.SetX(Math.Int((screen_width  - scaled_width)  / 2));
logo.sprite.SetY(Math.Int((screen_height - scaled_height) / 2) - Math.Int(screen_height * 0.05));

// Progress bar
bar_width  = Math.Int(screen_width * 0.30);
bar_height = 3;
bar_x      = Math.Int((screen_width - bar_width) / 2);
bar_y      = Math.Int(logo.sprite.GetY() + scaled_height + Math.Int(screen_height * 0.04));

bar_bg = Rectangle(bar_width, bar_height);
bar_bg.SetForegroundColor(0.2, 0.2, 0.2);
bar_bg_sprite = Sprite(bar_bg.AsImage());
bar_bg_sprite.SetX(bar_x);
bar_bg_sprite.SetY(bar_y);

progress = 0;

fun refresh_callback() {
    progress = Math.Min(progress + 0.005, 1.0);
    bar_fill = Rectangle(Math.Int(bar_width * progress), bar_height);
    bar_fill.SetForegroundColor(1.0, 1.0, 1.0);
    bar_fill_sprite = Sprite(bar_fill.AsImage());
    bar_fill_sprite.SetX(bar_x);
    bar_fill_sprite.SetY(bar_y);
}

Plymouth.SetRefreshFunction(refresh_callback);
